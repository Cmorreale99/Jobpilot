# JobPilot environment configuration.
# Copy to .env and fill in values. Defaults reflect the safe, mock-first path:
# the fixture-backed pipeline runs with ZERO real credentials.

# --- Core ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/jobpilot
SECRET_KEY=replace-me
# Fernet key that encrypts OAuth tokens at rest. Generate one with:
#   python -m app.security.crypto
TOKEN_ENCRYPTION_KEY=replace-me

# --- OAuth authorization flow (obtains tokens for the encrypted store) --------
# The authorization-code flow populates oauth_credentials. Leave blank to use the
# mock provider / fixture path. redirect URIs must match what's registered with each
# provider's OAuth app.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/drive.readonly
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
GITHUB_OAUTH_SCOPES=read:user repo

# --- LLM (Anthropic) ----------------------------------------------------------
# Mock-first: with LLM_ENABLED=false the deterministic fake client is used and no API
# key is required — the full pipeline runs offline. Set LLM_ENABLED=true and provide a
# key to call the real Messages API. Two tiers, env-configurable: BULK is cheap/fast
# (stage-1 scoring, bulk extraction); DEEP is strong (top-N re-rank, outreach, prep).
LLM_ENABLED=false
# Use the LLM-backed PAR structurer during Master CV ingestion instead of the heuristic.
# Needs a real client (LLM_ENABLED=true); otherwise ingestion warns and keeps the heuristic.
MASTER_CV_LLM_STRUCTURING=false
# Use the LLM-backed two-stage matchers (BULK scorer + DEEP reranker) instead of the
# heuristics. Needs a real client (LLM_ENABLED=true); otherwise matching warns and stays heuristic.
MATCHING_LLM_RANKING=false
# Use the LLM-backed tailorer + outreach drafter (DEEP tier) instead of the deterministic
# templates. Needs a real client (LLM_ENABLED=true); otherwise drafting warns and stays heuristic.
TAILORING_LLM_DRAFTING=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_BULK=claude-sonnet-5
ANTHROPIC_MODEL_DEEP=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_RETRIES=2

# --- GitHub MCP (real integration; disabled by default) -----------------------
# When GITHUB_MCP_ENABLED=false, the fixture-backed mock GitHub client is used and no
# token/MCP is required. Only transport=http is wired today.
GITHUB_MCP_ENABLED=false
GITHUB_MCP_SERVER=
GITHUB_MCP_TRANSPORT=http
# Dev-only PAT fallback for a manual MCP run. In production the token comes from the
# encrypted oauth_credentials store, decrypted per request — do not set it here.
GITHUB_MCP_ACCESS_TOKEN=

# --- GitHub source scoping / safety -------------------------------------------
# Scope ingestion to the user's own account; do not scan all of GitHub by default.
# Forks and private repos are excluded unless explicitly opted in.
GITHUB_USERNAME=
GITHUB_INCLUDE_FORKS=false
GITHUB_INCLUDE_PRIVATE=false
GITHUB_ALLOW_BROAD_SCAN=false

# --- Google Drive MCP (real integration; disabled by default) -----------------
# When GDRIVE_MCP_ENABLED=false, the fixture-backed mock Drive client is used and no
# OAuth/MCP is required. Set to true only once the Google Workspace MCP server is
# configured. Only transport=http is wired today.
GDRIVE_MCP_ENABLED=false
GDRIVE_MCP_SERVER=
GDRIVE_MCP_TRANSPORT=http
# Dev-only credential fallback for a manual MCP run. In production these are NOT set
# here — tokens come from the encrypted oauth_credentials store, decrypted per request.
GDRIVE_MCP_USER_EMAIL=
GDRIVE_MCP_ACCESS_TOKEN=

# --- Google Drive source scoping / safety -------------------------------------
# Drive is only an evidence source for explicit career artifacts. Ingestion is scoped
# to a single approved folder and an allowlist of MIME types. Broad Drive scanning is
# OFF by default and must be turned on explicitly — never mine personal Drive content.
GDRIVE_SOURCE_FOLDER_ID=
GDRIVE_ALLOWED_MIME_TYPES=application/pdf,application/vnd.google-apps.document,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown
GDRIVE_ALLOW_BROAD_SCAN=false

# --- Pipeline flags -----------------------------------------------------------
ENABLE_LINKEDIN_SOURCE=false
# Safe default: drafted outreach waits in the approval queue and nothing sends
# automatically. (Sending itself lands with the real mail client in M6; until then
# enabling this only logs a warning.)
OUTREACH_AUTO_SEND=false
INTERVIEW_INBOX_SCAN=true
SHORTLIST_SIZE=250
TOP_N=10
